# ─────────────────────────────────────────
# AI Meeting Note Taker — Environment Config
# Copy this file to .env and fill in values
# ─────────────────────────────────────────

# OpenAI (Whisper transcription + optional GPT summarization)
OPENAI_API_KEY=sk-...

# Anthropic Claude (meeting summarization)
ANTHROPIC_API_KEY=sk-ant-...

# ── Google ────────────────────────────────
# OAuth credentials JSON downloaded from Google Cloud Console
# Needs scopes: Calendar readonly, Docs, Gmail send
GOOGLE_CREDENTIALS_FILE=credentials/google_credentials.json
GOOGLE_TOKEN_FILE=credentials/google_token.json

# ── Microsoft (Teams / Outlook) ───────────
# Azure AD App registration
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
# Comma-separated account emails to monitor
MICROSOFT_ACCOUNTS=you@company.com

# ── Email output ──────────────────────────
# SMTP settings for sending meeting notes
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=you@gmail.com
# Default recipients if not found from meeting (comma-separated)
DEFAULT_EMAIL_RECIPIENTS=you@gmail.com

# ── Bot credentials ───────────────────────
# Google account the bot will use to join meetings
BOT_GOOGLE_EMAIL=bot@gmail.com
BOT_GOOGLE_PASSWORD=

# Zoom bot credentials
BOT_ZOOM_EMAIL=bot@gmail.com
BOT_ZOOM_PASSWORD=

# Microsoft account for Teams
BOT_MICROSOFT_EMAIL=bot@company.com
BOT_MICROSOFT_PASSWORD=

# ── App settings ──────────────────────────
# How many minutes before a meeting to join
JOIN_BUFFER_MINUTES=2
# Directory to store recordings and transcripts
DATA_DIR=./data
# Whisper model: tiny, base, small, medium, large (or use openai API)
# Set to "api" to use OpenAI Whisper API instead of local model
WHISPER_MODEL=base
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
